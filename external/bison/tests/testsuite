%code
{
#include <assert.h>
#include <string.h>
#define USE(Var)

FILE *input;
static int power (int base, int exponent);

static void yyerror (YYLTYPE const * const llocp,  const char *msg);
int yylex (YYSTYPE *lvalp, YYLTYPE *llocp);
